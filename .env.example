# Firebase Client SDK（公開可の値。Console > プロジェクトの設定 > 全般 で確認）
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=magazine-yah-mobi.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=magazine-yah-mobi
# Storage バケット名は Console > Storage で確認（*.firebasestorage.app または *.appspot.com）
VITE_FIREBASE_STORAGE_BUCKET=magazine-yah-mobi.firebasestorage.app

# ローカル開発でエミュレータに接続する場合は 1
VITE_USE_EMULATORS=0

# scripts/seed-firestore.mjs・scripts/set-admin.mjs 用（サービスアカウントJSONのパス）
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
