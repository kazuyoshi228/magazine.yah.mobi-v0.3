rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 管理者判定: ①カスタムクレーム admin（ブートストラップ用・set-admin.mjs）
    // または ②admin_whitelist コレクションにログインメールが登録済み。
    // whitelist 方式はトークン更新を待たず追加即時反映される。
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admin_whitelist/$(request.auth.token.email))
      );
    }

    // ─── 管理者ホワイトリスト（email をドキュメントIDに使用） ───────────────
    match /admin_whitelist/{email} {
      // 自分のエントリの存在確認は本人が可能（UIの権限判定用）。一覧は admin のみ。
      allow read: if request.auth != null
        && (request.auth.token.email == email || isAdmin());
      allow write: if isAdmin();
    }

    // ─── 記事 ──────────────────────────────────────────────────────────────
    // 公開記事は誰でも読める。作成・更新・削除・下書き閲覧は admin のみ。
    // 一覧クエリは where("status","==","published") を含む場合のみ一般公開される。
    match /articles/{slug} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.slug == slug
        && request.resource.data.status in ["draft", "published", "archived"];
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── 価格プラン（CompareGrid・価格の単一ソース） ─────────────────────────
    // 価格は公開情報。誰でも読める（記事の {{price}} 焼き込み・比較表）。
    // 書き込みは admin のみ（実運用は seed-plans.mjs / 将来のCMS価格エディタ）。
    match /plans/{key} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── 計測イベント ──────────────────────────────────────────────────────
    // 匿名クライアントからの create のみ許可（形状を検証）。読み取りは admin のみ。
    match /events/{eventId} {
      allow create: if request.resource.data.type in ["pageview", "cta_click", "ai_crawl"]
        && request.resource.data.path is string
        && request.resource.data.path.size() <= 512
        && request.resource.data.createdAt is number
        && request.resource.data.keys().hasOnly([
          "type", "path", "articleSlug", "target", "sessionId",
          "lang", "country", "referrer", "userAgent", "crawlerName", "createdAt"
        ]);
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
