rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ─── 記事 ──────────────────────────────────────────────────────────────
    // 公開記事は誰でも読める。作成・更新・削除・下書き閲覧は admin のみ。
    // 一覧クエリは where("status","==","published") を含む場合のみ一般公開される。
    match /articles/{slug} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.slug == slug
        && request.resource.data.status in ["draft", "published", "archived"];
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── 計測イベント ──────────────────────────────────────────────────────
    // 匿名クライアントからの create のみ許可（形状を検証）。読み取りは admin のみ。
    match /events/{eventId} {
      allow create: if request.resource.data.type in ["pageview", "cta_click", "ai_crawl"]
        && request.resource.data.path is string
        && request.resource.data.path.size() <= 512
        && request.resource.data.createdAt is number
        && request.resource.data.keys().hasOnly([
          "type", "path", "articleSlug", "target", "sessionId",
          "lang", "country", "referrer", "userAgent", "crawlerName", "createdAt"
        ]);
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
